  "findings": [
    {
      "id": "FIND-001",
      "summary": "No entry_allowed field exists. StructureRulesAggregate couples exact entry targets to globally merged protection flags and padding, losing per-stage/per-structure attribution.",
      "classification": "OBSERVED",
      "source_ids": [
        "SRC-011",
        "SRC-012"
      ],
      "requirement_ids": [
        "CORE-REQ-001",
        "CORE-REQ-002"
      ],
      "depends_on": [],
      "conflicts_with": []
    },
    {
      "id": "FIND-002",
      "summary": "Use missing-or-false legacy entry gating and true as a stage-local absence of entry denial. Keep per-structure owner contributions for independent break/place protection and avoid implicit chest/interact denial from protection-only targets.",
      "classification": "PROPOSED",
      "source_ids": [
        "SRC-011",
        "SRC-012"
      ],
      "requirement_ids": [
        "CORE-REQ-001",
        "CORE-REQ-002"
      ],
      "depends_on": [
        "FIND-001"
      ],
      "conflicts_with": []
    },
    {
      "id": "FIND-003",
      "summary": "LegacyStageCompiler and Schema4StageCompiler both need entry independence. Owner now requires optional priority configuration: structures.rules.priority defaults 0 and affects active deny candidates, existing advanced explicit action ALLOW rules retain numeric override semantics, deny wins ties, entry_allowed=true never creates ALLOW.",
      "classification": "PROPOSED",
      "source_ids": [
        "SRC-011",
        "SRC-012"
      ],
      "requirement_ids": [
        "CORE-REQ-001",
        "CORE-REQ-002"
      ],
      "depends_on": [
        "FIND-001"
      ],
      "conflicts_with": []
    },
    {
      "id": "FIND-004",
      "summary": "Actorless explosions/spawns currently ignore player stages. Preserve their unconditional semantics scoped to their own structure targets, preserve global block_structure_entry and provider/session arbitration, and document correction of cross-structure leakage.",
      "classification": "PROPOSED",
      "source_ids": [
        "SRC-012",
        "SRC-015"
      ],
      "requirement_ids": [
        "CORE-REQ-001",
        "CORE-REQ-002",
        "CORE-REQ-006"
      ],
      "depends_on": [
        "FIND-001"
      ],
      "conflicts_with": []
    },
    {
      "id": "FIND-005",
      "summary": "Both startup and loader fallback generate active showcase files. showcase:end_protocol explicitly locks jump. Empty configuration has no intrinsic jump lock; existing files skip generation. Defaults changes need two call sites plus non-destructive existing-config recovery.",
      "classification": "OBSERVED",
      "source_ids": [
        "SRC-013",
        "SRC-017"
      ],
      "requirement_ids": [
        "CORE-REQ-003",
        "CORE-REQ-006"
      ],
      "depends_on": [],
      "conflicts_with": []
    },
    {
      "id": "FIND-006",
      "summary": "The reported labels remain in current EssentialsPanel. EffectsPanel already supports explicit ability restriction edits. Improve plain labels, immediate help and restriction source visibility, retaining serialized keys and advanced functions.",
      "classification": "OBSERVED",
      "source_ids": [
        "SRC-014",
        "SRC-017"
      ],
      "requirement_ids": [
        "CORE-REQ-004",
        "CORE-REQ-006"
      ],
      "depends_on": [],
      "conflicts_with": []
    },
    {
      "id": "FIND-007",
      "summary": "LayoutPage already provides SVG pan/zoom/drag/connect and keyboard actions, but lacks a node context menu. Reuse StageActions and confirmation dialogs for nearby actions; prove pointer/keyboard/cycle/delete/review behavior without replacing the graph.",
      "classification": "PROPOSED",
      "source_ids": [
        "SRC-014",
        "SRC-017"
      ],
      "requirement_ids": [
        "CORE-REQ-005"
      ],
      "depends_on": [
        "FIND-006"
      ],
      "conflicts_with": []
    },
    {
      "id": "FIND-008",
      "summary": "Owner requires essential movement unrestricted in generated defaults and new stages. Preserve nonmovement showcase scope and existing files; retain explicit admin ability restrictions and documented old-pack recovery. Removing all ability enforcement or silently rewriting existing named stages is excluded.",
      "classification": "PROPOSED",
      "source_ids": [
        "SRC-013",
        "SRC-014"
      ],
      "requirement_ids": [
        "CORE-REQ-003",
        "CORE-REQ-006"
      ],
      "depends_on": [
        "FIND-005"
      ],
      "conflicts_with": []
    },
    {
      "id": "FIND-009",
      "summary": "Current explain target resolves only compiled rules and cannot prove actual legacy ability or structure provider causes. Extend bounded default-off diagnostic infrastructure around actual final evaluators, with provenance, contributors, revision, reason, permission checks and cleanup.",
      "classification": "OBSERVED",
      "source_ids": [
        "SRC-012",
        "SRC-013",
        "SRC-015"
      ],
      "requirement_ids": [
        "CORE-REQ-007"
      ],
      "depends_on": [
        "FIND-001",
        "FIND-005"
      ],
      "conflicts_with": []
    },
    {
      "id": "FIND-010",
